GITHUB_PERSONAL_ACCESS_TOKEN=
GOOGLE_API_KEY=
# Optional. Used as an automatic fallback for Gemini, or as the only model provider.
GROQ_API_KEY=

# Optional. Set true to run the GitHub MCP server with Docker instead of hosted MCP.
USE_DOCKER_MCP=false
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-120b
GITHUB_API_TIMEOUT_SECONDS=30
GITHUB_MAX_RETRIES=2

# Required before PR creation. Runs without a shell in the cloned target repository.
# Example for this project: python -m unittest discover -s ai_mlc/tests -v
PR_TEST_COMMAND=
PR_TEST_TIMEOUT_SECONDS=300
